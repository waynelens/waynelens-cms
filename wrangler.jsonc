{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waynelens-cms",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "cms.waynelens.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
